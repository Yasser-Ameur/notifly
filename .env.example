# NotiFly environment configuration.
# Copy to `.env` and adjust. All variables are prefixed with NOTIFLY_.

# --- Environment ---
NOTIFLY_ENVIRONMENT=development
NOTIFLY_DEBUG=false

# --- Infrastructure ---
NOTIFLY_DATABASE_URL=postgresql+asyncpg://notifly:notifly@localhost:5432/notifly
NOTIFLY_REDIS_URL=redis://localhost:6379/0

# --- Observability ---
NOTIFLY_LOG_LEVEL=INFO
NOTIFLY_JSON_LOGS=false
NOTIFLY_METRICS_ENABLED=true

# --- Scheduler ---
NOTIFLY_OUTBOX_POLL_INTERVAL=2.0
NOTIFLY_SCHEDULED_POLL_INTERVAL=15.0
NOTIFLY_RETRY_POLL_INTERVAL=30.0
